    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0"
