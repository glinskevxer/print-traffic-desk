{
  "name": "printdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Print traffic and rights clearance desk for repertory cinemas and film archives",
  "main": "src/http/server.js",
  "engines": {
    "node": ">=20.11 <21"
  },
  "scripts": {
    "start": "node src/http/server.js",
    "dev": "node --watch src/http/server.js",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "lint": "eslint src tests scripts",
    "test:integration": "jest --selectProjects integration",
    "test:coverage": "jest --coverage",
    "cli": "node src/cli/index.js",
    "seed": "node src/cli/index.js seed",
    "lint:fix": "eslint --fix src tests scripts",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "start:cluster": "node src/http/cluster.js",
    "worker": "node src/workers/index.js",
    "audit": "node scripts/audit-dependencies.js",
    "releasable": "node scripts/releasable.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "mongoose": "^8.9.5",
    "openai": "^4.80.1",
    "pino": "^9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "license": "UNLICENSED",
  "bin": {
    "printdesk": "src/cli/index.js"
  },
  "keywords": [
    "repertory",
    "film-archive",
    "print-traffic",
    "rights-clearance",
    "royalties",
    "express",
    "mongodb"
  ]
}
