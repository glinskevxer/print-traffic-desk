# Runtime
NODE_ENV=development
PORT=4010
LOG_LEVEL=debug
SERVICE_NAME=printdesk

# Storage
MONGO_URI=mongodb://127.0.0.1:27017/printdesk
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

# Desk policy
DEFAULT_TERRITORY=GB
DEFAULT_CURRENCY=GBP
HOLD_TTL_MINUTES=2880
INSPECTION_INTERVAL_SCREENINGS=6

# Licence and inspection note extraction
EXTRACTION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_ATTEMPTS=3
EXTRACTION_CONFIDENCE_FLOOR=0.7
EXTRACTION_DAILY_TOKEN_BUDGET=400000

# Operator sessions
AUTH_REQUIRED=true
AUTH_JWT_SECRET=change-me-to-at-least-thirty-two-characters
AUTH_TOKEN_TTL_MINUTES=480
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
